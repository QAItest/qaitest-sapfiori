# Application under test
SAP_BASE_URL=https://my-fiori.example.com/sap/bc/ui2/flp#MyApp-display
SAP_USERNAME=user@example.com
SAP_PASSWORD=change-me
SAP_AUTO_LOGIN=true

# Playwright execution
PW_HEADLESS=true
PW_WORKERS=2
PW_CHANNEL=chrome
ACCEPT_INSECURE_CERTS=false

# Optional Xray Cloud integration used by your publishing pipeline
XRAY_CLIENT_ID=
XRAY_CLIENT_SECRET=
XRAY_PROJECT_KEY=TEST

# Optional feature synchronization (local directory, ZIP, JSON manifest, or Xray endpoints)
FEATURE_SOURCE_PATH=
FEATURE_OUTPUT_DIR=tests/features
TEST_MANAGEMENT_SECRET_ID=
TEST_MGMT_AUTH_URL=
TEST_MGMT_GRAPHQL_URL=
TEST_MGMT_EXPORT_URL=

# Application under test
SAP_BASE_URL=https://my-fiori.example.com/sap/bc/ui2/flp#MyApp-display
SAP_USERNAME=user@example.com
SAP_PASSWORD=change-me
SAP_AUTO_LOGIN=true

# Explicit login/logout test (npm run test:auth disables automatic login)
# Prefer SAP_LOGOUT_URL when your system exposes a dedicated endpoint.
SAP_LOGOUT_URL=
# Otherwise configure the Fiori user menu and logout action. CSS selectors take precedence.
SAP_LOGOUT_MENU_SELECTOR=
SAP_LOGOUT_ACTION_SELECTOR=
SAP_LOGOUT_MENU_ROLE=Button
SAP_LOGOUT_MENU_PROPERTIES={"icon":"sap-icon://person-placeholder"}
SAP_LOGOUT_ACTION_ROLE=Button
SAP_LOGOUT_ACTION_PROPERTIES={"text":"Sign Out"}
# Optional URL assertions expressed as JavaScript regular expressions.
SAP_AUTHENTICATED_URL_PATTERN=
SAP_LOGGED_OUT_URL_PATTERN=

# Playwright execution
PW_HEADLESS=true
PW_WORKERS=2
PW_CHANNEL=chrome
ACCEPT_INSECURE_CERTS=false

# Optional Xray Cloud integration used by your publishing pipeline
XRAY_CLIENT_ID=
XRAY_CLIENT_SECRET=
XRAY_PROJECT_KEY=TEST

# Optional feature synchronization (local directory, ZIP, JSON manifest, or Xray endpoints)
FEATURE_SOURCE_PATH=
FEATURE_OUTPUT_DIR=tests/features
TEST_MANAGEMENT_SECRET_ID=
TEST_MGMT_AUTH_URL=
TEST_MGMT_GRAPHQL_URL=
TEST_MGMT_EXPORT_URL=

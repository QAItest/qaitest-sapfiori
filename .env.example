# Application under test
BASE_URL=https://my-fiori.example.com/sap/bc/ui2/flp#MyApp-display
BROWSER=chrome
HEADLESS=true
MAX_INSTANCES=2
TAGS=not @ignore

# Timeouts and diagnostics
WAIT_TIMEOUT=30000
UI5_TIMEOUT=30000
LOG_LEVEL=error
WDI5_LOG_LEVEL=error
ACCEPT_INSECURE_CERTS=false

# Optional wdi5 authentication: BTP, BasicAuth, Office365, custom, ...
# See the wdi5 authentication documentation for provider-specific values.
WDI5_AUTH_PROVIDER=BTP
WDI5_IDP_DOMAIN=my-tenant.accounts.ondemand.com
wdi5_username=user@example.com
wdi5_password=change-me
WDI5_WORKZONE=false

# Optional Xray Cloud integration used by your publishing pipeline
XRAY_CLIENT_ID=
XRAY_CLIENT_SECRET=
XRAY_PROJECT_KEY=TEST

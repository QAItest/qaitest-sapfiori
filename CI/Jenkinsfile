pipeline {
  agent any

  environment {
    SAP_BASE_URL = credentials('sap-fiori-base-url')
    SAP_USERNAME = credentials('sap-fiori-username')
    SAP_PASSWORD = credentials('sap-fiori-password')
  }

  stages {
    stage('Install') {
      steps {
        sh 'npm ci'
        sh 'npx playwright install chromium'
      }
    }
    stage('Validate') {
      steps { sh 'npm run typecheck' }
    }
    stage('Test') {
      steps { sh 'npm test' }
    }
  }

  post {
    always { archiveArtifacts artifacts: 'reports/**/*', allowEmptyArchive: true }
  }
}

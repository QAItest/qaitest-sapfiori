{
  "name": "qaitest-sapfiori",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Production-ready SAP Fiori, UI5, and WebGUI test template with Playwright SAP and Xray-ready reports.",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "clean:reports": "node -e \"const fs=require('node:fs');fs.rmSync('reports',{recursive:true,force:true});fs.mkdirSync('reports',{recursive:true});fs.writeFileSync('reports/.gitkeep','')\"",
    "install:browsers": "playwright install chromium",
    "test": "npm run clean:reports && playwright test",
    "test:headed": "npm run clean:reports && playwright test --headed",
    "test:debug": "npm run clean:reports && playwright test --debug",
    "test:smoke": "npm run clean:reports && playwright test --grep @smoke",
    "test:auth": "npm run clean:reports && cross-env SAP_AUTO_LOGIN=false playwright test --grep @auth",
    "test:ui": "playwright test --ui",
    "codegen": "playwright codegen",
    "report:open": "playwright show-report reports/html",
    "typecheck": "tsc --noEmit",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "report:summary": "tsx utils/xray-summary.ts",
    "test-export": "tsx utils/export_test_xray.ts",
    "test-import": "tsx utils/import_test_xray.ts",
    "test-sanitize": "tsx utils/gherkin_sanitizer.ts"
  },
  "devDependencies": {
    "@playwright/test": "npm:@playwright-sap/test@^1.1.6",
    "@types/adm-zip": "^0.5.8",
    "@types/node": "^24.10.0",
    "adm-zip": "^0.6.1",
    "cross-env": "^10.1.0",
    "dotenv": "^18.0.4",
    "prettier": "^3.9.9",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3"
  }
}
